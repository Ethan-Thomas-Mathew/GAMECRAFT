<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sky_blue"
    tools:context=".MainMenuActivity">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Flappy Ball"
        android:textSize="56sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/difficultySlider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.6" />

    <com.google.android.material.slider.Slider
        android:id="@+id/difficultySlider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:stepSize="1.0"
        android:value="1.0"
        android:valueFrom="0.0"
        android:valueTo="2.0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:thumbColor="@color/slider_thumb_color"
        app:trackColorActive="@color/slider_thumb_color"
        app:trackColorInactive="@color/slider_track_color" />

    <TextView
        android:id="@+id/easyLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Easy"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="@id/difficultySlider"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/difficultySlider"
        app:layout_constraintTop_toBottomOf="@id/difficultySlider" />

    <TextView
        android:id="@+id/mediumLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Medium"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="@id/difficultySlider"
        app:layout_constraintStart_toStartOf="@id/difficultySlider"
        app:layout_constraintTop_toBottomOf="@id/difficultySlider" />

    <TextView
        android:id="@+id/hardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hard"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="@id/difficultySlider"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@id/difficultySlider"
        app:layout_constraintTop_toBottomOf="@id/difficultySlider" />

    <Button
        android:id="@+id/playButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/button_color"
        android:paddingLeft="64dp"
        android:paddingTop="16dp"
        android:paddingRight="64dp"
        android:paddingBottom="16dp"
        android:text="Play"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mediumLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>